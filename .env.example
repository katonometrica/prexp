# Copy to .env (git-ignored) and replace every value:  Copy-Item .env.example .env
# Passwords: 32 or more random letters and digits, nothing else. Compose interpolates
# "$" in .env, and rocker copies the container environment into R's Renviron.site,
# where quotes, backslashes and "#" are altered.
#   Git Bash:   openssl rand -hex 24
#   PowerShell: [guid]::NewGuid().ToString('N')
# Save as UTF-8 without a byte-order mark.

# Owner of every database object (role prexp_owner, created by the postgres image)
POSTGRES_PASSWORD=change-me
# Login roles created by docker/db/init/01-roles.sh
PREXP_LOADER_PASSWORD=change-me
PREXP_APP_PASSWORD=change-me
# RStudio Server login for user rstudio at http://localhost:8787
RSTUDIO_PASSWORD=change-me

# How the containers reach PostgreSQL on the Compose network (not the host port)
PREXP_DB_HOST=db
PREXP_DB_PORT=5432
PREXP_DB_NAME=prexp
PREXP_TEST_DB_NAME=prexp_test

# Host ports, always bound to 127.0.0.1. Change one if it is taken on this machine.
HOST_PORT_DB=5432
HOST_PORT_RSTUDIO=8787
HOST_PORT_APP=3838
