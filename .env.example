# Copy to .env (git-ignored) and replace every change-me:  Copy-Item .env.example .env
# (Linux, macOS: cp .env.example .env). Keep the other values unless a port is taken.
# The passwords are set when the database volume is created; to change them later, see
# "Stop and reset" in the README.
# Passwords: 32 or more random letters and digits, nothing else. Compose interpolates
# "$" in .env, and rocker copies the container environment into R's Renviron.site,
# where quotes, backslashes and "#" are altered.
#   Git Bash:   openssl rand -hex 24
#   PowerShell: [guid]::NewGuid().ToString('N')
# Save as UTF-8 without a byte-order mark.

# Owner of every database object (role prexp_owner, created by the postgres image)
POSTGRES_PASSWORD=change-me
# Login roles created by docker/db/init/01-roles.sh
PREXP_LOADER_PASSWORD=change-me
PREXP_APP_PASSWORD=change-me

# How the containers reach PostgreSQL on the Compose network (not the host port)
PREXP_DB_HOST=db
PREXP_DB_PORT=5432
PREXP_DB_NAME=prexp
PREXP_TEST_DB_NAME=prexp_test

# Database settings: dev (laptop-sized) or full, for the twelve-month window
# (docker/db/postgresql.full.conf, sized for a machine with about 100 GB for Docker).
# With full, set PREXP_DB_SHM_SIZE=8gb. Apply with: docker compose up -d db
PREXP_DB_CONFIG=dev
PREXP_DB_SHM_SIZE=1gb

# Host ports, always bound to 127.0.0.1. Change one if it is taken on this machine.
HOST_PORT_DB=5432
HOST_PORT_RSTUDIO=8787
HOST_PORT_APP=3838

# Linux only (Docker Engine): your user's id -u and id -g, so RStudio can write to the
# bind-mounted repository. Docker Desktop on Windows or macOS needs the defaults.
# HOST_UID=1000
# HOST_GID=1000
